#!/usr/bin/env bash
# Installs nginx and sets a 301 redirect from /redirect_me
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
sed -i "s#server_name _;#server_name _;\n    location /redirect_me {\n        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n    }#" /etc/nginx/sites-available/default
service nginx restart
