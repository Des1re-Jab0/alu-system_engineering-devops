#!/usr/bin/env bash
# Installs nginx with a 301 redirect and a custom 404 page
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
sed -i "s#server_name _;#server_name _;\n    location /redirect_me {\n        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n    }\n    error_page 404 /404.html;\n    location = /404.html {\n        internal;\n    }#" /etc/nginx/sites-available/default
service nginx restart
