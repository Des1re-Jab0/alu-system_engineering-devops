#!/usr/bin/env bash
# Configures Nginx to add an X-Served-By header containing the server hostname
sudo apt-get update -y
sudo apt-get install -y nginx
sudo sed -i "/X-Served-By/d" /etc/nginx/sites-available/default
echo "add_header X-Served-By \$hostname always;" | sudo tee /etc/nginx/conf.d/custom_header.conf > /dev/null
sudo nginx -t
sudo service nginx restart
